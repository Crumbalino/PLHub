# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...

# Cron security (generate with: openssl rand -hex 32)
CRON_SECRET=your-random-secret-here

# Google Analytics (optional)
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Site URL (used for SEO canonical tags and sitemap)
NEXT_PUBLIC_SITE_URL=https://thefootballhub.uk

# Sitewide noindex. Set to exactly "true" to noindex the whole site
# (meta robots + robots.txt). Anything else leaves indexing enabled.
# Read at build time -- changing it requires a redeploy.
SITE_NOINDEX=false
